# Copy this file to .env and adjust as needed.

PORT=3001

# Set to true once Ollama is installed, running, and the model below is pulled.
OLLAMA_ENABLED=false

# Ollama's default local address — no change needed for a normal local install.
OLLAMA_URL=http://127.0.0.1:11434

# Pick a model that fits a machine with no dedicated GPU and 16 GB RAM.
# See ../README.md > "Rekomendasi Model Ollama" for options.
OLLAMA_MODEL=qwen2.5:7b-instruct
